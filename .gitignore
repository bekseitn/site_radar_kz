# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# bin/detect_with_ollama's own log
/detect.log

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets

# Generated by "bin/rails sitemap:refresh" (config/sitemap.rb) — a build
# artifact of the live Site data, not something to check in.
/public/sitemap*.xml.gz

# Ignore key files for decrypting credentials and more.
/config/*.key


/app/assets/builds/*
!/app/assets/builds/.keep

# Ignore JetBrains IDE project files.
/.idea

# node_modules only holds daisyUI, vendored so Tailwind's @plugin
# directive can resolve it at build time (no JS bundler/app code uses it).
/node_modules
